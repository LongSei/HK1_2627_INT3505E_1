{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Body cho POST /api/v1/books (không có id, server tự sinh)",
  "type": "object",
  "required": [
    "title",
    "price",
    "categoryId",
    "authors"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "isbn": {
      "type": "string",
      "pattern": "^\\d{13}$"
    },
    "price": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "enum": [
            "VND"
          ]
        }
      }
    },
    "stock": {
      "type": "integer",
      "minimum": 0
    },
    "categoryId": {
      "type": "string",
      "pattern": "^cat_[0-9]+$"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/authorRef"
      }
    }
  },
  "$defs": {
    "authorRef": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^auth_[0-9]+$"
        },
        "role": {
          "enum": [
            "lead",
            "co",
            "ed"
          ]
        }
      }
    }
  }
}
