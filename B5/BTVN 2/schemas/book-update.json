{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Body cho PATCH /api/v1/books/{id} (cập nhật một phần)",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "isbn": {
      "type": "string",
      "pattern": "^\\d{13}$"
    },
    "price": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "enum": [
            "VND"
          ]
        }
      }
    },
    "stock": {
      "type": "integer",
      "minimum": 0
    },
    "categoryId": {
      "type": "string",
      "pattern": "^cat_[0-9]+$"
    }
  }
}
