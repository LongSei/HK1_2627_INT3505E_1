{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Book (representation trả về cho client)",
  "type": "object",
  "required": [
    "id",
    "title",
    "price",
    "stock",
    "category",
    "authors",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^book_[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "isbn": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{13}$"
    },
    "price": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "enum": [
            "VND"
          ]
        }
      }
    },
    "stock": {
      "type": "integer",
      "minimum": 0
    },
    "category": {
      "type": "object",
      "required": [
        "id",
        "name",
        "slug"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cat_[0-9]+$"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        }
      }
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/author"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "author": {
      "type": "object",
      "required": [
        "id",
        "name",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^auth_[0-9]+$"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "enum": [
            "lead",
            "co",
            "ed"
          ]
        }
      }
    }
  }
}
